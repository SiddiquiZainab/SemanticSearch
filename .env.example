# Copy to .env and replace placeholders where needed.
# Never commit .env or share API credentials.

# External dataset and artifact directory (prefer an absolute path).
SEMANTIC_SEARCH_DATA_DIR=./data

# Optional. Search works without Gemini explanations when this is unset.
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
